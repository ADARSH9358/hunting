# ---------------------------------------------------------------- core
ENVIRONMENT=development
# REQUIRED in production: long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-in-production-please-32+chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------- database / queue
# Local dev default is SQLite (no setup). Production: PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://jobhunt:jobhunt@localhost:5432/jobhunt
REDIS_URL=redis://localhost:6379/0
# inprocess = background thread in the API process (no Redis needed)
# celery    = Celery worker (docker-compose uses this)
TASK_BACKEND=inprocess
# Run a search automatically every N hours via Celery beat (0 = off)
SCHEDULED_SEARCH_CRON_HOURS=0

# ---------------------------------------------------------------- resume storage
MAX_UPLOAD_MB=5
# Optional Fernet key to encrypt resumes at rest:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
RESUME_ENCRYPTION_KEY=

# ---------------------------------------------------------------- LLM (optional)
# anthropic | openai | none. Without an LLM the app uses deterministic rule-based
# extraction; the match score is always deterministic.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------- crawling
HTTP_USER_AGENT=JobHuntAI/1.0 (+personal job-search assistant; respects robots.txt)
DEFAULT_HOST_RATE_PER_SEC=1.0
MAX_COMPANIES_PER_RUN=150
MAX_CONCURRENT_REQUESTS=8
# Comma-separated connector keys to enable (empty = every configured source)
ENABLED_SOURCES=
# Render JS-only career pages with Playwright (pip install playwright && playwright install chromium)
PLAYWRIGHT_ENABLED=false

# ---------------------------------------------------------------- keyed / licensed job data (all optional)
# Adzuna developer API (free): https://developer.adzuna.com  (country: in, gb, us, ...)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Jooble partner API (free): https://jooble.org/api/about
JOOBLE_API_KEY=
# JSearch on RapidAPI - Google for Jobs data incl. LinkedIn/Indeed/Glassdoor/Naukri listings
RAPIDAPI_KEY=
# SerpAPI - Google Jobs engine + search-engine company discovery
SERPAPI_KEY=
# Brave Search API - company / career-page discovery
BRAVE_SEARCH_API_KEY=
# Apify actors (third-party data provider - check each actor's terms before enabling)
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=
APIFY_NAUKRI_ACTOR=
APIFY_INDEED_ACTOR=
# LinkedIn recruiter hiring POSTS in India - on whenever APIFY_TOKEN is set (~$0.002/post)
APIFY_LINKEDIN_POSTS_ACTOR=harvestapi/linkedin-post-search
LINKEDIN_POSTS_PER_QUERY=25

# ---------------------------------------------------------------- Gmail (job application emails)
# OAuth 2.0 "Web application" client from Google Cloud Console - see README "Gmail setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an "Authorized redirect URI" of the OAuth client (goes through the Next.js proxy)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Where the browser is sent back to after connecting Gmail
FRONTEND_URL=http://localhost:3000
# Fernet key encrypting OAuth tokens at rest (recommended in production; derived from SECRET_KEY if empty)
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Pause between automatic sends, and the hard ceiling for the per-user daily limit
EMAIL_SEND_INTERVAL_SECONDS=30
EMAIL_DAILY_LIMIT_MAX=50

# ---------------------------------------------------------------- company size ranges
SMALL_COMPANY_MAX=50
MEDIUM_COMPANY_MAX=500

# docker-compose only
POSTGRES_PASSWORD=jobhunt
